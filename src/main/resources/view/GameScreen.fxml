<AnchorPane fx:id="rootPane" stylesheets="@../css/theme_style.css" prefHeight="400.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameController">
   <children>
      <BorderPane fx:id="containerPane" prefHeight="400.0" prefWidth="1000.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <StackPane fx:id="boardPane" prefHeight="400.0" prefWidth="800.0" BorderPane.alignment="CENTER" />
         </center>       
         <bottom>
            <StackPane prefHeight="80.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Back to Menu" StackPane.alignment="CENTER">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Button>
               </children>
            </StackPane>
         </bottom>
      </BorderPane>
   </children>
