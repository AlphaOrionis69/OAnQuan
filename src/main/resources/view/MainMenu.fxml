<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MainMenuController"
      alignment="CENTER" spacing="20" style="-fx-background-color: #f0f4c3;">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
    
    <Label text="Ô Ăn Quan" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
    
    <Button text="Start Game" minWidth="200" onAction="#handleStart" style="-fx-cursor: hand">
        <font><Font size="16.0" /></font>
    </Button>
    <Button text="Help" minWidth="200" onAction="#handleHelp" style="-fx-cursor: hand">
        <font><Font size="16.0" /></font>
    </Button>
    <Button text="Exit" minWidth="200" onAction="#handleExit" style="-fx-cursor: hand">
        <font><Font size="16.0" /></font>
    </Button>
</VBox>